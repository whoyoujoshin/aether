{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // The miner imports the TypeScript client's source (../clients/ts/src);
    // its packages resolve from here.
    "paths": {
      "@noble/hashes/*": ["./node_modules/@noble/hashes/*"],
      "@noble/post-quantum/*": ["./node_modules/@noble/post-quantum/*"],
      "@scure/base": ["./node_modules/@scure/base"],
      "@scure/bip39": ["./node_modules/@scure/bip39"],
      "@scure/bip39/*": ["./node_modules/@scure/bip39/*"]
    }
  },
  "include": ["src"]
}
