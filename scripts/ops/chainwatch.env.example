# Copy to /root/chainwatch.env and chmod 600.
# Leave a variable unset to skip that channel. Do not commit real values.
#
# CHAINWATCH_WEBHOOK=          JSON POST, one event per request (ntfy accepts the body as the message)
# CHAINWATCH_SECRET=           HMAC key. Header X-Aether-Signature, same scheme as minerwatch.
# CHAINWATCH_DISCORD_WEBHOOK=  Discord webhook URL. Anyone with it can post to that channel.
